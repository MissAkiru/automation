# n8n environment variables — set in n8n Settings → Environment
# (or as -e flags on the docker run command). Used by the workflows in
# automation/. Never commit real values.

# News (3-hour world news job + content hook)
GNEWS_API_KEY=

# Google Sheet "HOK Ops" — the document ID from the sheet URL
SHEETS_DOC_ID=
SHEETS_TAB_NAME=Blog Autopost Log

# Blog autopost
LINKEDIN_AUTHOR_URN=urn:li:person:XXXXXXXX

# Daily brief email destination
BRIEF_TO_EMAIL=missakirubusiness@gmail.com

# Voice calls (Twilio) — where the agent calls
CALL_TO=+971547783323

# YouTube manual-upload defaults (the form also asks at upload time)
YT_TITLE=
YT_DESC=
